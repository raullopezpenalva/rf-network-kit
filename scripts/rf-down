#!/bin/bash
set -euo pipefail

SERVICE_NAME="${RF_SERVICE_NAME:-AX88179B}"

SCRIPT_PATH="$(realpath "$0")"
PROJECT_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
CONF="$PROJECT_ROOT/config/dnsmasq-rf.conf"

echo "[RF] Stopping dnsmasq..."

PID="$(pgrep -f "dnsmasq.*$CONF" || true)"

if [ -n "$PID" ]; then
    echo "[RF] Stopping PID $PID"
    sudo kill "$PID" 2>/dev/null || true
else
    echo "[RF] No rf-network-kit dnsmasq process found."
fi

echo "[RF] Returning $SERVICE_NAME to DHCP..."
sudo networksetup -setdhcp "$SERVICE_NAME"

echo "[RF] Stopped."